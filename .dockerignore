# Local credential files must never enter the Docker build context — no
# stage needs them, and `COPY . .` would bake them into an image layer.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Build/dependency artifacts — not part of the build context; the deps
# stage runs its own `npm ci` inside the image.
node_modules
dist
dist-ssr
*.local
.git
.DS_Store
.vscode
.idea
