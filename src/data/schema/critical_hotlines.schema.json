{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bettergov.ph/schemas/critical_hotlines.schema.json",
  "title": "Critical Hotlines",
  "description": "Schema for the CMS-owned critical hotlines generated by npm run sync:talacms",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "category", "numbers", "description"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Name of the organization or service",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "description": "Category of the hotline service",
        "enum": [
          "Emergency",
          "Disaster",
          "Security",
          "Transport",
          "Weather",
          "Utility",
          "Social Services"
        ]
      },
      "numbers": {
        "type": "array",
        "description": "List of contact numbers for this hotline",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "description": {
        "type": "string",
        "description": "Description of the hotline service",
        "minLength": 1
      }
    },
    "additionalProperties": false
  }
}
