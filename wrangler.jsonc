// Production is the default for the connected Cloudflare Workers Build.
// Use --env staging for the separate govph.workers.dev account.
// Production bindings are repeated for the explicit --env production alias;
// named environments do not inherit KV or rate limit bindings.
// Staging KV is automatically provisioned in its own account on first deploy.
{
  "name": "govph-dev",
  "account_id": "aad322f46c1fe4bdd854d8b1367b1d7f",
  "compatibility_date": "2025-11-17",
  "main": "functions/index.ts",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "BROWSER_KV",
      "id": "0c903bf8530b4a6a9019e7445c2f9aff",
    },
    {
      "binding": "FOREX_KV",
      "id": "3907d2c4829148a8a83974839f273d45",
    },
    {
      "binding": "WEATHER_KV",
      "id": "afd30412016d46c9b3482c8da86bf419",
    },
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "!/api/projects.json", "/weather", "/forex"],
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2026101401",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "ASSISTANT_RATE_LIMITER",
      "namespace_id": "2026101402",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      "name": "CRAWL_RATE_LIMITER",
      "namespace_id": "2026101403",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "2026101404",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "env": {
    "production": {
      "name": "govph-dev",
      "account_id": "aad322f46c1fe4bdd854d8b1367b1d7f",
      "routes": [
        {
          "pattern": "www.gov.ph",
          "custom_domain": true,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "BROWSER_KV",
          "id": "0c903bf8530b4a6a9019e7445c2f9aff",
        },
        {
          "binding": "FOREX_KV",
          "id": "3907d2c4829148a8a83974839f273d45",
        },
        {
          "binding": "WEATHER_KV",
          "id": "afd30412016d46c9b3482c8da86bf419",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "2026101401",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "ASSISTANT_RATE_LIMITER",
          "namespace_id": "2026101402",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
        {
          "name": "CRAWL_RATE_LIMITER",
          "namespace_id": "2026101403",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "REPORT_RATE_LIMITER",
          "namespace_id": "2026101404",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
    },
    "staging": {
      "name": "govph-dev",
      "account_id": "4c8b67ea7626b52e375842607904dd07",
      "routes": [],
      "kv_namespaces": [
        {
          "binding": "BROWSER_KV",
        },
        {
          "binding": "FOREX_KV",
        },
        {
          "binding": "WEATHER_KV",
        },
      ],
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "2026101401",
          "simple": {
            "limit": 120,
            "period": 60,
          },
        },
        {
          "name": "ASSISTANT_RATE_LIMITER",
          "namespace_id": "2026101402",
          "simple": {
            "limit": 20,
            "period": 60,
          },
        },
        {
          "name": "CRAWL_RATE_LIMITER",
          "namespace_id": "2026101403",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
        {
          "name": "REPORT_RATE_LIMITER",
          "namespace_id": "2026101404",
          "simple": {
            "limit": 5,
            "period": 60,
          },
        },
      ],
    },
  },
  "routes": [
    {
      "pattern": "www.gov.ph",
      "custom_domain": true,
    },
  ],
}
