# Meilisearch indexing scripts only (the browser always uses /api/search)
VITE_MEILISEARCH_HOST=https://search.example.com
VITE_MEILISEARCH_PORT=443
# Worker runtime variable: set in the dashboard's Variables & Secrets or in
# gitignored .dev.vars locally. HTTPS origin only; no path, query or credentials.
# There is no fallback origin, and this value is never read by the browser.
MEILISEARCH_ORIGIN=https://search.example.com
# Worker runtime secret: set with `wrangler secret put MEILISEARCH_SEARCH_API_KEY --env production`
# or in gitignored .dev.vars for local development. Search-only permissions on
# bettergov, bettergov_flood_control, contractors. Never use the master key.
MEILISEARCH_SEARCH_API_KEY=

# Deployment accounts and KV bindings are configured in wrangler.jsonc.
# Default target: production; staging: --env staging. Runtime secrets must
# be set separately for each target; .env is not a Worker secret deployment.
# Cloudflare Configuration
BETTERGOV_ACCOUNT_ID= # Cloudflare Account ID
BETTERGOV_BROWSER_KV_ID= # Browser KV Namespace ID
BETTERGOV_FOREX_KV_ID= # Forex KV Namespace ID  
BETTERGOV_WEATHER_KV_ID= # Weather KV Namespace ID

# API Keys
WEATHER_API_KEY= # Weather API key
OPENWEATHERMAP_API_KEY= # OpenWeatherMap API key
FOREX_API_KEY= # Forex API key
JINA_API_KEY= # Jina.ai API key
CF_ACCOUNT_ID= # Cloudflare Account ID (for Browser API)
CF_API_TOKEN= # Cloudflare API Token (for Browser API)

# TalaCMS — optional, used only by `npm run cms:fetch` to refresh the
# committed services, categories and hotlines JSON in src/data. Never read by
# the website, the Worker or `npm run build`.
TALACMS_API_URL= # Full CDA GraphQL endpoint, e.g. https://bettergov.talacms.com/cda/v1/graphql
TALACMS_API_TOKEN= # TalaCMS CDA-capability bearer token
# TALACMS_ENVIRONMENT=production # optional; sent as the X-Environment header
# eGovAI assistant — read only by the Cloudflare Worker
# (functions/api/assistant.ts), never by the website bundle; there is no
# VITE_ prefix on purpose. Set these as Worker *runtime* secrets
# (`wrangler secret put <NAME>` or the dashboard's Variables & Secrets), and in
# a local `.dev.vars` for `npm run functions:dev`.
EGOVAI_BASE_URL= # eGovAI API origin, e.g. https://egovai.example.gov.ph — no path
EGOVAI_API_KEY= # sent as X-EGOVAI-API-KEY
EGOVAI_API_SECRET= # sent as X-EGOVAI-API-SECRET
# EGOVAI_AGENT_ENGINE_CODE=govph # optional; defaults to govph
